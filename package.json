{
  "name": "trip-organizer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "import": "tsx importer/cli.ts",
    "dev:server": "node --watch server/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "node server/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "better-sqlite3": "^13.0.3",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.8",
    "fflate": "^0.8.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "preact": "^11.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
